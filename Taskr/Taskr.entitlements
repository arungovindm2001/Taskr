<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must be off: a sandboxed app cannot read other processes' stats via libproc. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Lets Taskr ask System Events for the list of login items (hardened runtime blocks Apple events otherwise). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
